# ComfyUI đang chạy ở đâu
COMFYUI_URL=http://127.0.0.1:8188

# Workflow dạng API export từ ComfyUI + file map node
STUDIO_WORKFLOW=workflows/flux_lineart.api.json
STUDIO_WORKFLOW_MAP=workflows/flux_lineart.map.json

# Thư mục chứa toàn bộ sách
STUDIO_LIBRARY=library

# Tham số sinh ảnh.
# ĐỂ TRỐNG thì dùng nguyên giá trị ghi trong workflow — nên để trống.
# Mỗi model một kiểu: schnell 4 bước CFG 1, SDXL 28 bước CFG 7.
STUDIO_STEPS=
STUDIO_GUIDANCE=

# Đổi sang SDXL (negative prompt CÓ tác dụng, khác Flux):
# STUDIO_WORKFLOW=workflows/sdxl_lineart.api.json
# STUDIO_WORKFLOW_MAP=workflows/sdxl_lineart.map.json

# Thời gian chờ tối đa cho MỘT ảnh (giây)
STUDIO_TIMEOUT=600

# Cho lệnh `subjects` — sinh bộ chủ thể cho chủ đề bất kỳ.
# Chạy bằng model local trong LM Studio: bật LM Studio, tab Developer,
# nạp model rồi bấm Start Server. Không cần API key.
LMSTUDIO_URL=http://localhost:1234/v1

# Để trống thì tự lấy model đang nạp. Nạp nhiều model thì ghi rõ tên ở đây.
STUDIO_LLM_MODEL=
